# Database
DATABASE_URL=postgresql://robotina:robotina@localhost:5432/robotina

# Redis
REDIS_URL=redis://localhost:6379

# LangWatch (Phase 4+)
LANGWATCH_API_KEY=
LANGWATCH_ENDPOINT=
# Optional UI base for clickable trace links in eval reports
# (e.g. https://app.langwatch.ai/<project-slug> or http://192.168.x.x:5560/<project-slug>).
# Leave empty to render just the bare trace_id in 22-EVAL-RESULTS-*.md.
LANGWATCH_UI_BASE_URL=

# Telegram (Phase 3+)
TELEGRAM_BOT_TOKEN=

# Gateway household identity (Phase 16+)
# REQUIRED. The gateway refuses to start (sys.exit(1)) if HOUSEHOLD_ID is
# unset, empty, or whitespace-only. Set this to the household UUID for this
# deployment. The default ships EMPTY on purpose (Phase 16 WR-04) so an
# unedited copy of .env fails the boot guard rather than silently persisting
# a placeholder string into Conversation / WorkflowRun rows. See:
#   - src/robotina/gateway/__init__.py::main (boot guard)
#   - src/robotina/queue/task_types.py::NonEmptyHouseholdId (Pydantic validator)
HOUSEHOLD_ID=

# Tavily Web Search (Phase 8+)
TAVILY_API_KEY=

# LLM API tokens (Phase 4+)
RECIPE_RESEARCH_GATHER_API_TOKEN=
RECIPE_RESEARCH_INSTRUCTIONS_API_TOKEN=
RECIPE_RESEARCH_INGREDIENTS_API_TOKEN=
RECIPE_RESEARCH_METADATA_API_TOKEN=
RECIPE_LOAD_API_TOKEN=
HANDLE_INCOMING_MESSAGE_API_TOKEN=
ACKNOWLEDGE_ADD_RECIPE_API_TOKEN=
VALIDATE_CATALOG_API_TOKEN=
GATHER_FROM_URL_API_TOKEN=
# SEND_NOTIFICATION_API_TOKEN was removed in Phase 07.1 — send-notification
# is now a deterministic non-LLM Python path (no API token required).

# Household Manager API (Phase 3+)
HOUSEHOLD_MANAGER_API_URL=
HOUSEHOLD_MANAGER_API_KEY=
HOUSEHOLD_MANAGER_BASE_URL=http://localhost:3001

# Agent overrides (Phase 4+)
AGENT_OVERRIDES_FILEPATH=

# Dashboard (Phase 13)
# Port the queue visibility dashboard listens on. Default 8001.
# Used by `uv run dashboard` and the dashboard service in docker-compose.yml.
DASHBOARD_PORT=8001
# Bind address. Default 127.0.0.1 (loopback only) — the dashboard has NO
# authentication and exposes workflow shared_context, step_input, and
# failure_reason which may contain PII / sensitive exception strings.
# Set to 0.0.0.0 only when running behind a trusted boundary (e.g. the
# compose network or a private VPN). The docker-compose dashboard service
# sets this to 0.0.0.0 explicitly so uvicorn accepts connections from
# outside the container.
DASHBOARD_HOST=127.0.0.1

# URL ingestion (Phase 23) — Dev/testing only; never set in production.
# When true (1|true|yes), safe_fetch() allows http:// scheme. Default false
# (https-only). Used by the gather-from-url agent's FetchAndScrapeTool.
URL_INGESTION_ALLOW_HTTP=false
